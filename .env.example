# Copy this file to .env and fill in real values for local development.
# Never commit .env — it is gitignored.

# --- Database ---
DATABASE_URL="postgresql://whisperbox:whisperbox@localhost:5432/whisperbox"

# --- Cache / Sessions / Presence / Rate limiting ---
REDIS_URL="redis://localhost:6379"

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32+-character-random-secret"
AUTH_URL="http://localhost:3000"

# --- Object storage (Cloudflare R2 / S3-compatible) ---
# Optional outside production — leave blank to run auth/messaging/sockets
# locally without provisioning real R2 credentials. config/env.ts enforces
# these as required once NODE_ENV=production.
R2_BUCKET=""
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_ENDPOINT=""

# --- Realtime ---
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Observability (optional in development) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
LOG_LEVEL="info"
