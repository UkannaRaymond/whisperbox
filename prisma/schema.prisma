
generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth core tables (lib/auth.ts: prismaAdapter(prisma, { provider:
// "postgresql" })). Field names/shapes follow Better Auth's own default
// Prisma schema — these are managed by Better Auth's `auth.api.*`, not by
// this app's repository layer (see services/session.service.ts).
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  // WhisperBox-owned relations
  profile              UserProfile?
  devices              Device[]
  contactsOwned        Contact[]              @relation("ContactOwner")
  contactOf            Contact[]              @relation("ContactTarget")
  conversationsCreated Conversation[]         @relation("ConversationCreator")
  conversationMembers  ConversationMember[]
  sentMessages         Message[]              @relation("MessageSender")
  uploadedAttachments  Attachment[]           @relation("AttachmentUploader")
  encryptedMessageKeys EncryptedMessageKey[]  @relation("EncryptedMessageKeyRecipient")
  messageReceipts      MessageReceipt[]
  notifications        Notification[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// WhisperBox domain
// ---------------------------------------------------------------------------

enum UserStatus {
  ONLINE
  AWAY
  BUSY
  INVISIBLE
  OFFLINE
}

/// 1:1 with User — kept separate from Better Auth's own `User` row (see
/// repositories/interfaces/user.repository.interface.ts's doc comment).
/// May not exist yet for an account that signed up but hasn't completed
/// the /onboarding/username step.
model UserProfile {
  userId      String    @id
  username    String    @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  status      UserStatus @default(OFFLINE)
  lastSeenAt  DateTime?
  /// Whether this profile shows up in UserRepository#search results.
  searchable  Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@map("user_profile")
}

enum DevicePlatform {
  WINDOWS
  MACOS
  LINUX
  ANDROID
  IOS
  WEB
}

/// A device's E2E identity key — intentionally separate from Better
/// Auth's login `Session` (schemas/session.schema.ts's doc comment).
model Device {
  id               String         @id @default(uuid())
  userId           String
  name             String
  platform         DevicePlatform
  devicePublicKey  String
  fingerprint      String
  deviceIdentifier String
  appVersion       String?
  osVersion        String?
  trusted          Boolean        @default(false)
  revoked          Boolean        @default(false)
  revokedAt        DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime       @default(now())

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityKey          IdentityKey?
  signedPreKeys        SignedPreKey[]
  oneTimePreKeys       OneTimePreKey[]

  @@unique([userId, devicePublicKey])
  @@index([userId])
  @@map("device")
}


model IdentityKey {
  id        String   @id @default(uuid())
  deviceId  String   @unique
  publicKey String
  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("identity_key")
}

model SignedPreKey {
  id          String   @id @default(uuid())
  deviceId    String
  keyId       Int
  publicKey   String
  signature   String
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
  @@map("signed_pre_key")
}

model OneTimePreKey {
  id        String   @id @default(uuid())
  deviceId  String
  keyId     Int
  publicKey String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
  @@map("one_time_pre_key")
}

/// A lightweight ownership relation — "userId added contactId to their
/// contacts" — not itself the messaging relationship (see
/// repositories/prisma/contact.repository.ts's doc comment: no
/// `deletedAt`, since there's nothing to soft-delete here).
model Contact {
  id         String    @id @default(uuid())
  ownerId    String
  contactId  String
  nickname   String?
  notes      String?
  favorite   Boolean   @default(false)
  pinned     Boolean   @default(false)
  blocked    Boolean   @default(false)
  blockedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner   User @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contact User @relation("ContactTarget", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactId])
  @@index([contactId])
  @@map("contact")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationVisibility {
  PRIVATE
  PUBLIC
}

model Conversation {
  id            String                 @id @default(uuid())
  type          ConversationType
  name          String?
  description   String?
  avatar        String?
  visibility    ConversationVisibility @default(PRIVATE)
  createdById   String
  archived      Boolean                @default(false)
  deleted       Boolean                @default(false)
  deletedAt     DateTime?
  lastMessageId String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  createdBy User                 @relation("ConversationCreator", fields: [createdById], references: [id])
  members   ConversationMember[]
  messages  Message[]

  @@index([createdById])
  @@index([type])
  @@map("conversation")
}

enum MemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

/// No `deletedAt` on this model — "no longer a member" is `leftAt != null`
/// (repositories/interfaces/conversation-member.repository.interface.ts).
model ConversationMember {
  id                 String     @id @default(uuid())
  conversationId     String
  userId             String
  role               MemberRole @default(MEMBER)
  muted              Boolean    @default(false)
  archived           Boolean    @default(false)
  pinned             Boolean    @default(false)
  lastReadMessageId  String?
  joinedAt           DateTime   @default(now())
  leftAt             DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_member")
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  LOCATION
  CONTACT
  SYSTEM
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id                 String        @id @default(uuid())
  conversationId     String
  senderId           String
  /// Client-generated idempotency key — unique, lets the offline queue
  /// safely retry a send (services/message.service.ts#createMessage).
  clientMessageId    String        @unique
  type               MessageType   @default(TEXT)
  /// AES-GCM ciphertext. The server never receives or stores plaintext.
  encryptedContent   String
  /// AES-GCM nonce/IV for encryptedContent. Never reused with the same key.
  nonce              String
  encryptionVersion  Int           @default(1)
  status             MessageStatus @default(SENT)
  /// Per-conversation monotonic sequence number. See
  /// repositories/prisma/message.repository.ts's doc comment on `create()`
  /// for the known (documented, not fixed here) race under concurrent load.
  sequenceNumber     BigInt
  replyToMessageId   String?
  pinned             Boolean       @default(false)
  edited             Boolean       @default(false)
  editedAt           DateTime?
  deleted            Boolean       @default(false)
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  conversation  Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User                   @relation("MessageSender", fields: [senderId], references: [id])
  replyTo       Message?               @relation("MessageReplies", fields: [replyToMessageId], references: [id])
  replies       Message[]              @relation("MessageReplies")
  encryptedKeys EncryptedMessageKey[]
  receipts      MessageReceipt[]
  attachments   Attachment[]

  @@index([conversationId, createdAt])
  @@index([conversationId, sequenceNumber])
  @@map("message")
}

/// Wraps a message's AES content key per RECIPIENT USER (not per device —
/// see the multi-device caveat documented at length on
/// `IMessageRepository` in repositories/interfaces/message.repository.interface.ts).
/// `algorithm` defaults to "X25519" here (the original, unused X3DH
/// design's default) — the repository layer always passes
/// "RSA-OAEP-4096" explicitly for the scheme actually in use; see
/// `EncryptedMessageKeyRepository#create`.
model EncryptedMessageKey {
  id           String   @id @default(uuid())
  messageId    String
  recipientId  String
  encryptedKey String
  algorithm    String   @default("X25519")
  createdAt    DateTime @default(now())

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient User    @relation("EncryptedMessageKeyRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientId])
  @@map("encrypted_message_key")
}

/// Per-recipient delivery/read tracking — distinct from `Message.status`,
/// which is conversation-wide (repositories/interfaces/message-receipt.repository.interface.ts).
model MessageReceipt {
  id          String    @id @default(uuid())
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("message_receipt")
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

/// `size` is BigInt (files can exceed 2^31 bytes). `storageKey` is the R2
/// object key; a signed download URL is generated on read, never stored
/// (repositories/interfaces/attachment.repository.interface.ts).
model Attachment {
  id               String         @id @default(uuid())
  messageId        String
  uploadedById     String
  type             AttachmentType
  fileName         String
  originalFileName String?
  mimeType         String
  extension        String?
  size             BigInt
  storageKey       String
  thumbnailKey     String?
  previewKey       String?
  encryptedKey     String
  nonce            String
  checksum         String
  width            Int?
  height           Int?
  duration         Int?
  downloadCount    Int            @default(0)
  deleted          Boolean        @default(false)
  deletedAt        DateTime?
  uploadedAt       DateTime       @default(now())

  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([messageId])
  @@map("attachment")
}

enum NotificationType {
  MESSAGE
  MENTION
  CONTACT_REQUEST
  GROUP_INVITE
  SYSTEM
}

/// Field names follow repositories/prisma/notification.repository.ts's doc
/// comment exactly: `read`/`readAt` (not `isRead`), `payload` (not
/// `data`), `dismissed`/`dismissedAt` as this model's soft-delete
/// equivalent (no `deletedAt` column).
model Notification {
  id           String            @id @default(uuid())
  userId       String
  type         NotificationType
  title        String
  body         String?
  payload      Json?
  read         Boolean           @default(false)
  readAt       DateTime?
  dismissed    Boolean           @default(false)
  dismissedAt  DateTime?
  createdAt    DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notification")
}
